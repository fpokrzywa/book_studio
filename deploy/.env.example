# Personal Book Studio server settings. install.sh copies this to deploy/.env (git-ignored) and
# fills in the values marked "install.sh". Never commit deploy/.env.

# The name people type in the browser. Nginx Proxy Manager serves it over HTTPS.
PBS_DOMAIN=books.example.com

# Docker network shared with Nginx Proxy Manager (install.sh creates it if missing; connect NPM to it).
PBS_PROXY_NETWORK=npm_proxy
# Addresses whose X-Forwarded-* headers Core trusts. "auto" = install.sh fills in the subnet of
# PBS_PROXY_NETWORK. If NPM runs on another machine, put its address here, e.g. ["192.168.1.10"].
PBS_TRUSTED_PROXIES=auto
# Only if NPM runs on another machine: the address:port this server publishes Core on.
PBS_PUBLISH_HTTP=

# Where everything lives on the server (host folders; Docker never deletes them).
PBS_DATA_DIR=/srv/book-studio/data
PBS_BACKUP_DIR=/srv/book-studio/backups
PBS_MASTER_KEY_FILE=/srv/book-studio/secrets/pbs_master_key
PBS_OLLAMA_DIR=/srv/book-studio/ollama

# Image tag (install.sh and update.sh set it to the git revision).
PBS_IMAGE_TAG=local

# AI. Private model hosts that count as local (never "the internet"): the Ollama container,
# Ollama installed on this server, or another computer you trust, by name or IPv4 address.
PBS_LOCAL_AI_HOSTS=["ollama","host.docker.internal"]
# none | docker (run the bundled ollama container: --profile local-ai)
PBS_OLLAMA=none
PBS_OLLAMA_TAG=latest
# false = cloud AI providers can never be used, whatever is chosen in the app.
PBS_ALLOW_CLOUD=true

# Limits and logging.
PBS_MAX_UPLOAD_MB=200
PBS_SESSION_IDLE_MINUTES=720
PBS_SESSION_MAX_DAYS=14
PBS_LOG_LEVEL=INFO
# 1 = include eSpeak NG for local narration (then rebuild).
PBS_WITH_ESPEAK=0
